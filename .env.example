# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.

# Ambiente: development | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Conexión a PostgreSQL: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=postgresql://leeconnos:leeconnos@localhost:5432/leeconnos

# true si el proveedor de la base exige SSL (bases administradas en la nube)
DB_SSL=false

# Secreto con el que se firman los JWT. En producción: mínimo 32 caracteres aleatorios.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-este-secreto-de-desarrollo

# Vigencia del token (formato de la librería ms: 30m, 2h, 7d)
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS, separados por coma. * permite cualquiera (solo desarrollo).
CORS_ORIGIN=*

# --- Reglas de los servicios dummy ---
# Subtotal (CLP) desde el cual el despacho es gratis
ENVIO_GRATIS_DESDE=40000

# Segundos entre cada hito del seguimiento simulado
SEGUIMIENTO_PASO_SEGUNDOS=60

# --- Solo docker compose: credenciales del contenedor de PostgreSQL ---
POSTGRES_USER=leeconnos
POSTGRES_PASSWORD=leeconnos
POSTGRES_DB=leeconnos
