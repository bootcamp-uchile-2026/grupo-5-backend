# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.

# Ambiente: development | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Conexión a PostgreSQL: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=postgresql://leeconnos:leeconnos@localhost:5432/leeconnos

# true si el proveedor de la base exige SSL (bases administradas en la nube)
DB_SSL=false

# Aplicar las migraciones de TypeORM pendientes al arrancar (estructura y datos de prueba).
# Con false se aplican a mano: npm run migration:run
DB_MIGRAR_AL_INICIAR=true

# Secreto con el que se firman los JWT. En producción: mínimo 32 caracteres aleatorios.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-este-secreto-de-desarrollo

# Vigencia del token (formato de la librería ms: 30m, 2h, 7d)
JWT_EXPIRES_IN=2h

# Vigencia del refreshToken: permite renovar la sesión con POST /auth/refresh
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por coma. * permite cualquiera (solo desarrollo).
# Con sesión por cookie, además son los únicos orígenes desde los que se aceptan
# peticiones que modifican datos (protección CSRF). En el servidor: la URL de la Web.
CORS_ORIGIN=*

# --- Sesión con cookies HttpOnly (Aplicación Web) ---
# true exige HTTPS. Por defecto: true si NODE_ENV=production.
COOKIE_SECURE=false
# lax: Web y API en el mismo sitio. none: en dominios distintos (exige COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# Opcional: dominio padre para compartir la cookie entre subdominios (ej. .leeconnos.cl)
COOKIE_DOMAIN=

# --- Imágenes subidas ---
# Carpeta donde se guardan (en Docker es el volumen uploads)
UPLOADS_DIR=uploads
# Tamaño máximo por imagen, en MB
IMAGEN_MAX_MB=2
# URL pública de la API, para armar la URL de cada imagen. Vacía: se usa el host de la petición.
# En el servidor: http://3.131.220.134:3000 o https://3-131-220-134.sslip.io
PUBLIC_URL=

# URL de la aplicación Web: se usa en los enlaces de los correos
# (verificar correo, restablecer contraseña, darse de baja, pedido de invitado)
FRONTEND_URL=http://localhost:5173

# --- Correos (verificación de cuenta, recuperación de contraseña, pedidos) ---
# Sin SMTP_HOST los correos NO se envían: quedan en el log con su enlace (desarrollo).
# Con SMTP_HOST se envían de verdad. Ejemplo con Gmail (requiere verificación en dos
# pasos y una "contraseña de aplicación" de 16 letras: myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=cuenta@gmail.com  SMTP_PASS=<contraseña de aplicación>
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465; por defecto se deduce del puerto
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remitente que ve el usuario (con Gmail debe ser la misma cuenta de SMTP_USER)
MAIL_FROM=LeeConNos <no-responder@leeconnos.cl>

# Con true (y NODE_ENV distinto de production) las respuestas incluyen el token del
# correo, para completar los flujos sin bandeja real.
EXPONER_TOKENS_DEV=false

# --- Acceso con Google / Facebook (opcional) ---
# Sin estos valores, POST /auth/google y /auth/facebook responden 503 PROVEEDOR_NO_CONFIGURADO.
# Google: Client ID de tipo Web (console.cloud.google.com > Credenciales). Se aceptan varios separados por coma.
GOOGLE_CLIENT_ID=
# Facebook: App ID y App Secret (developers.facebook.com > Configuración básica)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Reglas de los servicios dummy ---
# Subtotal (CLP) desde el cual el despacho es gratis
ENVIO_GRATIS_DESDE=40000

# Segundos entre cada hito del seguimiento simulado
SEGUIMIENTO_PASO_SEGUNDOS=60

# --- Solo docker compose: imagen de la API publicada en Docker Hub ---
# Para actualizar el servidor basta con cambiar API_VERSION (ver docs/despliegue.md).
DOCKERHUB_USUARIO=usuario-docker-hub
API_VERSION=0.4.0

# --- Solo docker compose: credenciales del contenedor de PostgreSQL ---
POSTGRES_USER=leeconnos
POSTGRES_PASSWORD=leeconnos
POSTGRES_DB=leeconnos

# --- Solo docker compose con HTTPS (perfil https) ---
# Dominio que apunta a la IP del servidor. Sin dominio propio sirve sslip.io:
# 3-131-220-134.sslip.io resuelve a 3.131.220.134 y Caddy obtiene el certificado solo.
DOMINIO=localhost
