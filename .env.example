# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.

# Ambiente: development | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Conexión a PostgreSQL: postgresql://usuario:clave@host:puerto/base
DATABASE_URL=postgresql://leeconnos:leeconnos@localhost:5432/leeconnos

# true si el proveedor de la base exige SSL (bases administradas en la nube)
DB_SSL=false

# Secreto con el que se firman los JWT. En producción: mínimo 32 caracteres aleatorios.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-este-secreto-de-desarrollo

# Vigencia del token (formato de la librería ms: 30m, 2h, 7d)
JWT_EXPIRES_IN=2h

# Vigencia del refreshToken: permite renovar la sesión con POST /auth/refresh
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por coma. * permite cualquiera (solo desarrollo).
CORS_ORIGIN=*

# URL de la aplicación Web: se usa en los enlaces de los correos
# (verificar correo, restablecer contraseña, darse de baja, pedido de invitado)
FRONTEND_URL=http://localhost:5173

# Correos DUMMY: quedan en el log. Con true (y NODE_ENV distinto de production)
# las respuestas incluyen el token del correo para completar los flujos sin bandeja real.
EXPONER_TOKENS_DEV=false

# --- Acceso con Google / Facebook (opcional) ---
# Sin estos valores, POST /auth/google y /auth/facebook responden 503 PROVEEDOR_NO_CONFIGURADO.
# Google: Client ID de tipo Web (console.cloud.google.com > Credenciales). Se aceptan varios separados por coma.
GOOGLE_CLIENT_ID=
# Facebook: App ID y App Secret (developers.facebook.com > Configuración básica)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Reglas de los servicios dummy ---
# Subtotal (CLP) desde el cual el despacho es gratis
ENVIO_GRATIS_DESDE=40000

# Segundos entre cada hito del seguimiento simulado
SEGUIMIENTO_PASO_SEGUNDOS=60

# --- Solo docker compose: credenciales del contenedor de PostgreSQL ---
POSTGRES_USER=leeconnos
POSTGRES_PASSWORD=leeconnos
POSTGRES_DB=leeconnos

# --- Solo docker compose con HTTPS (perfil https) ---
# Dominio que apunta a la IP del servidor. Sin dominio propio sirve sslip.io:
# 3-131-220-134.sslip.io resuelve a 3.131.220.134 y Caddy obtiene el certificado solo.
DOMINIO=localhost
